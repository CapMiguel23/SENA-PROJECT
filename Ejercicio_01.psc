Algoritmo Ejercicio_01
	
	//  Cálculo del área y perímetro de un rectángulo.
	
	Definir base, altura Como Entero
	
	Escribir "Ingrese La Base De Su Rectángulo (Cm): "
	Leer base
	Escribir "Ingrese La Altura De Su Rectángulo (Cm): "
	Leer altura
	
	area <- base * altura
	perimetro <- (2*base) + (2*altura)
	
	Escribir "Área es igual a: ", area, " cm ^ 3."
	Escribir "Perímetro es igual a: ", perimetro, " cm."
	
FinAlgoritmo
