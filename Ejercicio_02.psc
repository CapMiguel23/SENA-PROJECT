Algoritmo Ejercicio_02
	
	//Conversión de temperatura de Celsius a Fahrenheit.
	
	Definir Celsius, Fahrenheit Como Entero
	
	Escribir "Ingrese Su Temperatura en Celsius (°C): "
	Leer Celsius
	
	Fahrenheit <- (Celsius * 1.8) + 32
	
	Escribir "Conversión: ", Celsius, " °C = ", Fahrenheit, " °F."
	
FinAlgoritmo
